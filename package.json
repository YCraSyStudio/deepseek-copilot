{
  "name": "yrs-dpsk-copilot",
  "displayName": "Yar's Deepseek copilot - A VS Code copilot specialized on Deepseek.",
  "description": "A deeply integrated VS Code coding assistant specialized in DeepSeek.",
  "version": "0.1.10",
  "preview": true,
  "publisher": "yarcrasy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YCraSyStudio/deepseek-copilot.git"
  },
  "homepage": "https://ycrasystudio.github.io/deepseek-copilot/",
  "bugs": {
    "url": "https://github.com/YCraSyStudio/deepseek-copilot/issues"
  },
  "icon": "src/assets/DeepSeekIcon.png",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "ai",
    "assistant",
    "copilot",
    "chat",
    "coding",
    "agent"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "File, search, Git, and terminal tools require a local file-backed workspace."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat remains available, but workspace tools fail closed until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "yrs-dpsk-copilot.installChromiumHeadless",
        "title": "Yar's DeepSeek Copilot: Install Chromium Headless",
        "category": "Yar's DeepSeek Copilot"
      },
      {
        "command": "yrs-dpsk-copilot.removeChromiumHeadless",
        "title": "Yar's DeepSeek Copilot: Remove Chromium Headless",
        "category": "Yar's DeepSeek Copilot"
      },
      {
        "command": "yrs-dpsk-copilot.updateChromiumHeadless",
        "title": "Yar's DeepSeek Copilot: Update Chromium Headless",
        "category": "Yar's DeepSeek Copilot"
      },
      {
        "command": "yrs-dpsk-copilot.openChat",
        "title": "Yar's DeepSeek Copilot: Open Chat",
        "category": "Yar's DeepSeek Copilot"
      },
      {
        "command": "yrs-dpsk-copilot.addFileToChat",
        "title": "Yar's DeepSeek Copilot: Add File to Chat",
        "category": "Yar's DeepSeek Copilot",
        "icon": "$(add)"
      },
      {
        "command": "yrs-dpsk-copilot.addSelectionToChat",
        "title": "Yar's DeepSeek Copilot: Add Selection to Chat",
        "category": "Yar's DeepSeek Copilot",
        "icon": "$(add)"
      },
      {
        "command": "yrs-dpsk-copilot.newChat",
        "title": "Yar's DeepSeek Copilot: New Chat",
        "category": "Yar's DeepSeek Copilot",
        "icon": "$(add)"
      },
      {
        "command": "yrs-dpsk-copilot.reviewChanges",
        "title": "Yar's DeepSeek Copilot: Review Changes",
        "category": "Yar's DeepSeek Copilot",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "yrs-dpsk-copilot.showDiagnostics",
        "title": "Yar's DeepSeek Copilot: Show Diagnostics",
        "category": "Yar's DeepSeek Copilot"
      },
      {
        "command": "yrs-dpsk-copilot.clearDiagnostics",
        "title": "Yar's DeepSeek Copilot: Clear Diagnostics",
        "category": "Yar's DeepSeek Copilot"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "yrs-dpsk-copilot.addFileToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "yrs-dpsk-copilot.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation@50"
        },
        {
          "command": "yrs-dpsk-copilot.reviewChanges",
          "when": "resourceScheme == file",
          "group": "navigation@51"
        }
      ],
      "scm/title": [
        {
          "command": "yrs-dpsk-copilot.reviewChanges",
          "group": "navigation@50"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yrs-dpsk-copilot-sidebar",
          "title": "Yar's DeepSeek Copilot",
          "icon": "src/assets/DeepSeekIcon.svg"
        }
      ]
    },
    "views": {
      "yrs-dpsk-copilot-sidebar": [
        {
          "type": "webview",
          "id": "yrs-dpsk-copilot.chatView",
          "name": "Chat",
          "icon": "src/assets/DeepSeekIcon.svg",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./ --noEmit",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.js --production",
    "build:webview": "vite build --config src/ui/vite.config.mts",
    "dev:webview": "vite --config src/ui/vite.config.mts --host 0.0.0.0 --port 5175 --strictPort",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "prepare:integration": "npm run build && node scripts/build-integration-tests.mjs",
    "test:integration": "npm run prepare:integration && vscode-test",
    "package:vsix": "node scripts/prepare-artifacts.mjs && vsce package --no-dependencies --out artifacts",
    "verify:vsix": "node scripts/assert-vsix-contents.mjs"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.1.0",
    "@vscode/codicons": "^0.0.45",
    "puppeteer-core": "^25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "yauzl": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.0.7"
  }
}
